# Copy thành $DEPLOY_PATH/.env trên server (KHÔNG commit file thật)

# Chỉ dùng ký tự chữ/số để không phải encode trong DATABASE_URL
POSTGRES_PASSWORD=doi-mat-khau-manh

# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
COOKIE_SECURE=true
CORS_ORIGINS=["https://your-domain.vn"]

TIMEZONE=Asia/Ho_Chi_Minh

# Bảo mật + booking engine (T-005). Các biến này PHẢI có trên server: mặc định chỉ cho http://localhost:3000
# Origin được phép gửi request ghi kèm cookie phiên (chống CSRF): đặt đúng domain của môi trường
ALLOWED_ORIGINS=["https://your-domain.vn"]
# Số proxy tin cậy trước API để lấy IP thật từ X-Forwarded-For cho rate limit/nhật ký.
# Đã đo trên link dev (26/10/2026): Caddy ghi XFF, Next KHÔNG nối thêm -> đặt 1. Đặt 2 sẽ ra IP container web (172.x).
TRUSTED_PROXY_COUNT=1
RATE_LIMIT_PER_MINUTE=120
TENANT_ID=1

# Đặt sân online + thanh toán QR SePay (T-008). Chưa đủ 5 biến SEPAY_* đầu -> web vẫn xem lịch nhưng tạm ngưng đặt online.
# Giá trị thật do chủ sân nhập trên server, không ghi vào repo/board. Cấu hình SePay: mã nội dung "BK" + 11 số.
SEPAY_BANK_CODE=
SEPAY_BANK_NAME=
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_NAME=
SEPAY_WEBHOOK_SECRET=
# 0 = không kiểm độ lệch timestamp của webhook
SEPAY_TIMESTAMP_TOLERANCE_SECONDS=0
ONLINE_HOLD_MINUTES=5
ONLINE_HOLD_GRACE_SECONDS=60
# Giả lập tiền về (/payments/dev/simulate). CHỈ link dev (kèm APP_ENV=staging bên dưới). Production bật -> app không khởi động.
PAYMENTS_SIMULATE=false
# Chỉ link dev: APP_ENV=staging. Production: để trống/không khai báo (mặc định production).
# APP_ENV=staging

# Tài khoản chủ sân tạo bởi: docker compose exec api python -m app.scripts.seed
FIRST_ADMIN_EMAIL=admin@your-domain.vn
FIRST_ADMIN_PASSWORD=

WEB_PORT=3000
