ENV=development
DATABASE_URL=postgresql+asyncpg://caulong:caulong@localhost:5432/caulong
REDIS_URL=redis://localhost:6379/0

# Tạo bằng: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
COOKIE_SECURE=false
# Khách: access token hết hạn sau N phút, refresh token sau N ngày
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
# Đăng nhập quản trị: phiên hết hạn sau N giờ; sai N lần liên tiếp thì khóa M phút
ADMIN_SESSION_HOURS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Mỗi IP sai quá N lần trong M phút (mọi tài khoản cộng lại) thì chặn IP đó
LOGIN_IP_MAX_ATTEMPTS=20
LOGIN_IP_WINDOW_MINUTES=15
# Đăng ký tài khoản khách: tối đa N lần gọi / giờ mỗi IP
REGISTER_IP_MAX_PER_HOUR=10
# Quên mật khẩu: OTP hết hạn sau N phút, sai N lần thì hủy; giới hạn gửi theo SĐT và IP
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60
OTP_MAX_PER_HOUR=5
OTP_IP_MAX_PER_HOUR=20
OTP_RESET_TOKEN_MINUTES=10
# Zalo ZNS gửi OTP – để trống: chưa gửi, dev ghi OTP ra log của worker
ZALO_APP_ID=
ZALO_SECRET_KEY=
ZALO_REFRESH_TOKEN=
ZALO_TEMPLATE_OTP=
# Đăng nhập Google cho khách: Client ID (Web) từ Google Cloud Console
GOOGLE_CLIENT_ID=
# COOKIE_DOMAIN=.yourdomain.vn
# Origin được phép (CORS + chặn CSRF: POST/PATCH/DELETE kèm cookie phiên từ origin khác ⇒ 403).
# Cùng domain với request (qua Next rewrite) luôn được; thêm origin khác nếu gọi API thẳng
CORS_ORIGINS=["http://localhost:3000"]
# Proxy tin cậy (IP/CIDR, dấu phẩy) – chỉ khi request đến từ đây mới đọc IP khách trong
# X-Forwarded-For (giới hạn đăng nhập sai theo IP). Next + Caddy cùng máy: mặc định là đủ.
# Docker compose (web gọi api qua mạng compose): thêm subnet mạng đó, vd 172.16.0.0/12
TRUSTED_PROXIES=127.0.0.1,::1

TIMEZONE=Asia/Ho_Chi_Minh
OPEN_TIME=05:00
CLOSE_TIME=23:00
SLOT_MINUTES=30
MIN_BOOKING_MINUTES=60
MAX_ADVANCE_DAYS=30
HOLD_MINUTES=10

FIRST_ADMIN_PHONE=0912345678
FIRST_ADMIN_PASSWORD=Admin@12345
