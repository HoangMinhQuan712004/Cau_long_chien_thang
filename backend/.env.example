ENV=development
DATABASE_URL=postgresql+asyncpg://caulong:caulong@localhost:5432/caulong
REDIS_URL=redis://localhost:6379/0

# Tạo bằng: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
COOKIE_SECURE=false
# COOKIE_DOMAIN=.yourdomain.vn
CORS_ORIGINS=["http://localhost:3000"]

# Bảo mật (ADR-004)
# Origin được phép gửi request ghi kèm cookie phiên (chống CSRF). Prod: ["https://chienthang.superbai.vip"]
ALLOWED_ORIGINS=["http://localhost:3000"]
# Số proxy GHI X-Forwarded-For đứng trước API, để lấy IP thật của khách. 0 = không tin XFF (chạy cục bộ).
# Prod/dev (Caddy -> Next -> API) = 1: Caddy ghi XFF, Next rewrite chỉ chuyển tiếp, không nối thêm
# (đo trên link dev 26/10: =2 ra IP container web).
TRUSTED_PROXY_COUNT=0
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
MAX_BODY_BYTES=65536

# Booking engine: tenant của bản chạy này
TENANT_ID=1

TIMEZONE=Asia/Ho_Chi_Minh

FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=admin12345

# Đặt online + SePay (T-008). Đủ 5 biến SEPAY_* đầu -> bật đặt online; thiếu -> "gọi hotline".
SEPAY_BANK_CODE=
SEPAY_BANK_NAME=
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_NAME=
SEPAY_WEBHOOK_SECRET=
# 0 = không chặn theo tuổi timestamp webhook (ADR-001 §2)
SEPAY_TIMESTAMP_TOLERANCE_SECONDS=0
ONLINE_HOLD_MINUTES=5
ONLINE_HOLD_GRACE_SECONDS=60
# Chỉ máy dev / link dev (ENV=staging): POST /payments/dev/simulate. ENV=production + true -> không khởi động
PAYMENTS_SIMULATE=false
