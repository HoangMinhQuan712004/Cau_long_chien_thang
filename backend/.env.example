ENV=development
DATABASE_URL=postgresql+asyncpg://caulong:caulong@localhost:5432/caulong
REDIS_URL=redis://localhost:6379/0

# Tạo bằng: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
COOKIE_SECURE=false
# COOKIE_DOMAIN=.yourdomain.vn
CORS_ORIGINS=["http://localhost:3000"]

# Bảo mật (ADR-004)
# Origin được phép gửi request ghi kèm cookie phiên (chống CSRF). Prod: ["https://chienthang.superbai.vip"]
ALLOWED_ORIGINS=["http://localhost:3000"]
# Số proxy GHI X-Forwarded-For đứng trước API, để lấy IP thật của khách. 0 = không tin XFF (chạy cục bộ).
# Prod/dev (Caddy -> Next -> API) = 1: Caddy ghi XFF, Next rewrite chỉ chuyển tiếp, không nối thêm
# (đo trên link dev 26/10: =2 ra IP container web).
TRUSTED_PROXY_COUNT=0
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
MAX_BODY_BYTES=65536

# Booking engine: tenant của bản chạy này
TENANT_ID=1

TIMEZONE=Asia/Ho_Chi_Minh

# Admin đầu tiên (T-013): migration gán SĐT này cho Admin chưa có SĐT (thiếu -> migration DỪNG);
# seed tạo Admin khi chưa có. Production: SĐT thật + mật khẩu riêng (mật khẩu mẫu bị từ chối).
FIRST_ADMIN_PHONE=0912345678
FIRST_ADMIN_PASSWORD=Admin@12345

# Đăng nhập / phiên / OTP (T-013)
ADMIN_SESSION_HOURS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
LOGIN_IP_MAX_ATTEMPTS=20
LOGIN_IP_WINDOW_MINUTES=15
REGISTER_IP_MAX_PER_HOUR=10
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60
OTP_MAX_PER_HOUR=5
OTP_IP_MAX_PER_HOUR=20
OTP_RESET_TOKEN_MINUTES=10
BOOKING_PHONE_TOKEN_MINUTES=30
# Chỉ máy dev / link dev: mã OTP của khách trả trong response. ENV=production + true -> không khởi động
OTP_TEST_MODE=false
# Zalo ZNS gửi OTP (làm sau). Thiếu -> production tạm ngưng đặt online + quên mật khẩu
ZALO_APP_ID=
ZALO_SECRET_KEY=
ZALO_REFRESH_TOKEN=
ZALO_TEMPLATE_OTP=
# Client ID Google (công khai) – trống: tắt đăng nhập Google
GOOGLE_CLIENT_ID=

# Đặt online + SePay (T-008). Đủ 5 biến SEPAY_* đầu -> bật đặt online; thiếu -> "gọi hotline".
SEPAY_BANK_CODE=
SEPAY_BANK_NAME=
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_NAME=
SEPAY_WEBHOOK_SECRET=
# 0 = không chặn theo tuổi timestamp webhook (ADR-001 §2)
SEPAY_TIMESTAMP_TOLERANCE_SECONDS=0
ONLINE_HOLD_MINUTES=5
ONLINE_HOLD_GRACE_SECONDS=60
# Chỉ máy dev / link dev (ENV=staging): POST /payments/dev/simulate. ENV=production + true -> không khởi động
PAYMENTS_SIMULATE=false
# Khóa mã hóa khóa webhook SePay lưu trong DB (T-012): Fernet 32 byte base64 urlsafe.
# Bắt buộc khi ENV=staging/production. Sinh: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PAYMENTS_ENCRYPTION_KEY=
