ENV=development
DATABASE_URL=postgresql+asyncpg://caulong:caulong@localhost:5432/caulong
REDIS_URL=redis://localhost:6379/0

# Tạo bằng: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
COOKIE_SECURE=false
# COOKIE_DOMAIN=.yourdomain.vn
CORS_ORIGINS=["http://localhost:3000"]

# Bảo mật (ADR-004)
# Origin được phép gửi request ghi kèm cookie phiên (chống CSRF). Prod: ["https://chienthang.superbai.vip"]
ALLOWED_ORIGINS=["http://localhost:3000"]
# Số proxy tin cậy trước API để lấy IP thật từ X-Forwarded-For (Caddy -> Next -> API = 2). 0 = không tin XFF
TRUSTED_PROXY_COUNT=0
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
MAX_BODY_BYTES=65536

# Booking engine: tenant của bản chạy này
TENANT_ID=1

TIMEZONE=Asia/Ho_Chi_Minh
OPEN_TIME=05:00
CLOSE_TIME=23:00
SLOT_MINUTES=30
MIN_BOOKING_MINUTES=60
MAX_ADVANCE_DAYS=30
HOLD_MINUTES=10

FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=admin12345
